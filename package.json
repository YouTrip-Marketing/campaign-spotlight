{
  "name": "campaign-spotlight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Digest of standout marketing campaigns. Static site built from JSON issue files.",
  "engines": { "node": ">=20" },
  "scripts": {
    "next-issue": "node scripts/next-issue.mjs",
    "registry": "node scripts/registry.mjs",
    "validate": "node scripts/validate.mjs",
    "validate:links": "node scripts/validate.mjs --links all",
    "build": "node src/build.mjs",
    "slack-message": "node scripts/slack.mjs latest --dry-run",
    "test": "node --test"
  }
}
